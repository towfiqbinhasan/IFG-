# ---------------------------------------------------------------
# Supabase  (Project Settings -> API)
# ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used by /api/admin/* routes
# to create/reset/delete users. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ---------------------------------------------------------------
# Optional
# ---------------------------------------------------------------
# Domain suffix used to map usernames to internal Supabase Auth emails
# (username -> username@lab.local). Change only BEFORE creating users.
NEXT_PUBLIC_USERNAME_EMAIL_DOMAIN=lab.local

# Used by Capacitor (capacitor.config.ts) - the deployed web app URL the
# Android app loads. Not needed by Vercel.
CAP_SERVER_URL=https://your-app.vercel.app
